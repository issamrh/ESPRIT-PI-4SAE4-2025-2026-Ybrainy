pipeline {
    agent any

    environment {
        GIT_CREDENTIALS = 'github-token'
        DOCKER_USER = 'jjacem'
        APP_NAME = 'event-service'
        IMAGE_NAME = "${DOCKER_USER}/${APP_NAME}"
        DOCKER_TAG = "${BUILD_NUMBER}"
        SONAR_HOST_URL = 'http://127.0.0.1:42419'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'integration-final']],
                    extensions: [
                        [$class: 'CloneOption',
                            depth: 1,
                            shallow: true,
                            timeout: 300,
                            noTags: true
                        ],
                        [$class: 'SparseCheckoutPaths',
                            sparseCheckoutPaths: [
                                [$class: 'SparseCheckoutPath', path: 'ybrainy events/']
                            ]
                        ]
                    ],
                    userRemoteConfigs: [[
                        url: 'https://github.com/issamrh/ESPRIT-PI-4SAE4-2025-2026-Ybrainy.git',
                        credentialsId: "${GIT_CREDENTIALS}"
                    ]]
                ])
            }
        }

        stage('Build') {
            steps {
                script {
                    def workspacePath = env.WORKSPACE.replace('\\', '/')
                    def repoDir = "/mnt/${workspacePath.substring(0, 1).toLowerCase()}${workspacePath.substring(2)}"
                    bat """wsl bash -lc "cd '${repoDir}' && mvn -f pom.xml -pl event-service -am clean package -DskipTests" """
                }
            }
        }

        stage('Tests') {
            steps {
                script {
                    def workspacePath = env.WORKSPACE.replace('\\', '/')
                    def repoDir = "/mnt/${workspacePath.substring(0, 1).toLowerCase()}${workspacePath.substring(2)}"
                    bat """wsl bash -lc "cd '${repoDir}' && mvn -f pom.xml -pl event-service test" """
                }
            }
            post {
                always {
                    junit 'event-service/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    script {
                        def workspacePath = env.WORKSPACE.replace('\\', '/')
                        def repoDir = "/mnt/${workspacePath.substring(0, 1).toLowerCase()}${workspacePath.substring(2)}"
                        bat """
                        wsl bash -lc "cd '${repoDir}' && mvn -f pom.xml -pl event-service -am sonar:sonar -Dsonar.host.url=${SONAR_HOST_URL} -Dsonar.login=%SONAR_TOKEN% -Dsonar.projectKey=event-service"
                        """
                    }
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER_LOGIN',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    script {
                        def workspacePath = env.WORKSPACE.replace('\\', '/')
                        def repoDir = "/mnt/${workspacePath.substring(0, 1).toLowerCase()}${workspacePath.substring(2)}"
                        bat """
                        wsl bash -lc "cd '${repoDir}' && docker build -f event-service/Dockerfile -t ${IMAGE_NAME}:${DOCKER_TAG} . && docker tag ${IMAGE_NAME}:${DOCKER_TAG} ${IMAGE_NAME}:latest"
                        echo %DOCKER_PASSWORD% | wsl docker login -u %DOCKER_USER_LOGIN% --password-stdin
                        wsl docker push ${IMAGE_NAME}:${DOCKER_TAG}
                        wsl docker push ${IMAGE_NAME}:latest
                        """
                    }
                }
            }
        }

        stage('Save build info for CD') {
            steps {
                bat 'echo %DOCKER_TAG% > event-service-tag.txt'
                archiveArtifacts artifacts: 'event-service-tag.txt'
            }
        }
    }

    post {
        success {
            echo 'CI event-service reussi'
            build job: 'event-service-CD', wait: false
        }
        failure {
            echo 'CI event-service echoue'
        }
    }
}
