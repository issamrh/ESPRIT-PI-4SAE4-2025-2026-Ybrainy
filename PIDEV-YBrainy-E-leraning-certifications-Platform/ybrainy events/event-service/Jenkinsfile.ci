pipeline {
    agent any

    tools {
        maven 'M2_HOME'
        jdk   'JAVA_Home'
    }

    environment {
        GIT_CREDENTIALS = 'ybrainy-token'
        DOCKER_USER     = 'hos77'
        APP_NAME        = 'event-service'
        IMAGE_NAME      = "${DOCKER_USER}/${APP_NAME}"
        DOCKER_TAG      = "${BUILD_NUMBER}"
        SONAR_PROJECT   = 'event-service'
        SONAR_HOST_URL  = 'http://localhost:9000'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'integration-final']],
                    extensions: [
                        [$class: 'CloneOption',
                            depth: 1,
                            shallow: true,
                            timeout: 300,
                            noTags: true
                        ],
                        [$class: 'SparseCheckoutPaths',
                            sparseCheckoutPaths: [
                                [$class: 'SparseCheckoutPath', path: 'ybrainy events/']
                            ]
                        ]
                    ],
                    userRemoteConfigs: [[
                        url: 'https://github.com/issamrh/ESPRIT-PI-4SAE4-2025-2026-Ybrainy.git',
                        credentialsId: "${GIT_CREDENTIALS}"
                    ]]
                ])
            }
        }

        stage('Maven Clean') {
            steps {
                dir("${env.WORKSPACE}/ybrainy events/event-service") {
                    bat 'wsl mvn clean'
                }
            }
        }

        stage('Build') {
            steps {
                dir("${env.WORKSPACE}/ybrainy events/event-service") {
                    bat 'wsl mvn package -DskipTests'
                }
            }
        }

        stage('Unit Tests + JaCoCo Coverage') {
            steps {
                dir("${env.WORKSPACE}/ybrainy events/event-service") {
                    bat 'wsl mvn verify'
                    junit allowEmptyResults: true,
                          testResults: 'target/surefire-reports/*.xml'
                    jacoco execPattern:      'target/jacoco.exec',
                           classPattern:     'target/classes',
                           sourcePattern:    'src/main/java',
                           inclusionPattern: '**/*.class'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    withSonarQubeEnv('SonarQube') {
                        dir("${env.WORKSPACE}/ybrainy events/event-service") {
                            bat """
                            wsl mvn sonar:sonar ^
                              -Dsonar.host.url=${SONAR_HOST_URL} ^
                              -Dsonar.login=%SONAR_AUTH_TOKEN% ^
                              -Dsonar.projectKey=${SONAR_PROJECT} ^
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    timeout(time: 3, unit: 'MINUTES') {
                        waitForQualityGate abortPipeline: false
                    }
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER_LOGIN',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    dir("${env.WORKSPACE}/ybrainy events/event-service") {
                        bat """
                        wsl docker build -t ${IMAGE_NAME}:${DOCKER_TAG} . && wsl docker tag ${IMAGE_NAME}:${DOCKER_TAG} ${IMAGE_NAME}:latest
                        echo %DOCKER_PASSWORD% | wsl docker login -u %DOCKER_USER_LOGIN% --password-stdin
                        wsl docker push ${IMAGE_NAME}:${DOCKER_TAG}
                        wsl docker push ${IMAGE_NAME}:latest
                        """
                    }
                }
            }
        }

        stage('Save build info for CD') {
            steps {
                bat 'echo %DOCKER_TAG% > event-service-tag.txt'
                archiveArtifacts artifacts: 'event-service-tag.txt'
            }
        }

    }

    post {
        success {
            echo '========================================'
            echo 'CI SUCCESS — event-service'
            echo '========================================'
            build job: 'event-service-CD', wait: false
        }
        failure {
            echo 'CI FAILED  — event-service — check Console Output'
        }
    }
}
