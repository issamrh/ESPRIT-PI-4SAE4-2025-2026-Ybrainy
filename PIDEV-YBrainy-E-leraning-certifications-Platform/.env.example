# YBrainy Platform — Required Secrets
# Copy this file to .env and fill in your values before running docker-compose.
# NEVER commit .env to git.

# ── Stripe (course-service & payment-service) ─────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── OpenRouter AI (course-service) ────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# ── Groq AI (forum thread-service) ────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Groq AI (ybrainy events event-service — separate key) ─────────────────────
EVENT_GROQ_API_KEY=gsk_...

# ── RapidAPI (payment-service TTS + content writer) ───────────────────────────
TTS_API_KEY=...
CONTENT_WRITER_API_KEY=...

# ── Gmail SMTP (payment-service & cart-service) ───────────────────────────────
SPRING_MAIL_PASSWORD=...

# ── Static JWT auth (payment-service & cart-service) ─────────────────────────
AUTH_JWT_SECRET=...

# ── Events service (ybrainy events / event-service) ──────────────────────────
HF_TOKEN=hf_...
GITHUB_MODELS_API_KEY=github_pat_...

# ── TwelveData API (user Angular finance page) ────────────────────────────────
# Set in user/angular/angular-app/src/environments/environment.ts
# TWELVE_DATA_API_KEY=...
