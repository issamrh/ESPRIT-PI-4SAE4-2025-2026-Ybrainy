pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
  }

  parameters {
    choice(name: 'CLUSTER_TYPE', choices: ['minikube', 'kind', 'none'], description: 'How to make locally-built Docker images available to the cluster.')
    string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker tag to build/deploy.')
    string(name: 'DOCKER_REGISTRY', defaultValue: '', description: 'Optional registry prefix, e.g. registry.local:5000 or ghcr.io/<org>. Leave empty for local clusters.')
    string(name: 'DOCKER_REGISTRY_CREDENTIALS_ID', defaultValue: '', description: 'Optional Jenkins credentialsId (Username/Password) used for docker login when DOCKER_REGISTRY is set.')
    booleanParam(name: 'DEPLOY', defaultValue: true, description: 'Apply Kubernetes manifests after building images.')
  }

  environment {
    // Keep these aligned with k8s/*.yaml
    K8S_NAMESPACE = 'ybrainy'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build Images') {
      steps {
        sh '''
          echo "Selected params: CLUSTER_TYPE=${CLUSTER_TYPE:-} IMAGE_TAG=${IMAGE_TAG:-} DOCKER_REGISTRY=${DOCKER_REGISTRY:-} DEPLOY=${DEPLOY:-}"
        '''
        script {
          if (params.DOCKER_REGISTRY?.trim() && params.DOCKER_REGISTRY_CREDENTIALS_ID?.trim()) {
            withCredentials([usernamePassword(credentialsId: params.DOCKER_REGISTRY_CREDENTIALS_ID, usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
              sh '''
                set -euo pipefail
                registry_host="$(echo "${DOCKER_REGISTRY}" | awk -F/ '{print $1}')"
                echo "${REG_PASS}" | docker login "${registry_host}" --username "${REG_USER}" --password-stdin
              '''
            }
          }
        }
        sh '''
          set -euo pipefail
          chmod +x k8s/ci/*.sh
          K8S_NAMESPACE="${K8S_NAMESPACE}" \
          CLUSTER_TYPE="${CLUSTER_TYPE}" \
          IMAGE_TAG="${IMAGE_TAG}" \
          DOCKER_REGISTRY="${DOCKER_REGISTRY}" \
          bash k8s/ci/build-images.sh
        '''
      }
    }

    stage('Deploy') {
      when { expression { return params.DEPLOY } }
      steps {
        sh '''
          set -euo pipefail
          chmod +x k8s/ci/*.sh
          K8S_NAMESPACE="${K8S_NAMESPACE}" \
          IMAGE_TAG="${IMAGE_TAG}" \
          DOCKER_REGISTRY="${DOCKER_REGISTRY}" \
          bash k8s/ci/deploy.sh
        '''
      }
    }
  }
}
