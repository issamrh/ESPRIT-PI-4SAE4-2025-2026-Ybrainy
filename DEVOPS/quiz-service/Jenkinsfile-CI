pipeline {
    agent any

    environment {
        SERVICE_NAME   = 'quiz-service'
        SERVICE_DIR    = '/mnt/c/Users/azizs/Downloads/ESPRIT-PI-4SAE4-2025-2026-Ybrainy/PIDEV-YBrainy-E-leraning-certifications-Platform/YBRAINY/Quiz/quiz-service'
        SONAR_HOST_URL = 'http://localhost:9000'
        BUILD_DIR      = "/tmp/ybrainy-builds/${SERVICE_NAME}-${BUILD_NUMBER}"
    }

    options { skipDefaultCheckout(true) }

    tools { maven 'Maven' }

    stages {

        stage('Build & Test') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh "rm -rf ${SERVICE_DIR}/target 2>/dev/null || true"
                    sh "mvn clean verify -Dmaven.test.failure.ignore=false -Dbuild.dir=${BUILD_DIR}/target"
                }
            }
            post {
                always {
                    junit testResults: "${BUILD_DIR}/target/surefire-reports/*.xml",
                          allowEmptyResults: true
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token2', variable: 'SONAR_TOKEN')]) {
                    dir("${SERVICE_DIR}") {
                        sh """
                            mvn sonar:sonar \
                                -Dsonar.projectKey=${SERVICE_NAME} \
                                -Dsonar.projectName='YBrainy Quiz Service' \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.token=${SONAR_TOKEN} \
                                -Dsonar.coverage.jacoco.xmlReportPaths=${BUILD_DIR}/target/site/jacoco/jacoco.xml \
                                -Dsonar.scm.disabled=true \
                                -Dbuild.dir=${BUILD_DIR}/target
                        """
                    }
                }
            }
        }

        stage('Trigger CD') {
            steps {
                build job: 'quiz-service-CD',
                      parameters: [string(name: 'BUILD_TAG', value: "${BUILD_NUMBER}")],
                      wait: false
            }
        }
    }

    post {
        success  { echo "CI passed — triggered quiz-service-CD" }
        failure  { echo "CI FAILED — CD pipeline will NOT be triggered" }
        always   { sh "rm -rf ${BUILD_DIR} || true" }
    }
}
