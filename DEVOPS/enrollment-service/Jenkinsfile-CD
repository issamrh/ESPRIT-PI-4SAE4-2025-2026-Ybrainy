pipeline {
    agent any

    parameters {
        string(name: 'BUILD_TAG', defaultValue: 'latest', description: 'Image tag passed from CI pipeline')
    }

    environment {
        SERVICE_NAME   = 'enrollment-service'
        SERVICE_DIR    = '/mnt/c/Users/azizs/Downloads/ESPRIT-PI-4SAE4-2025-2026-Ybrainy/PIDEV-YBrainy-E-leraning-certifications-Platform/YBRAINY/Enrollment/enrollment-service'
        IMAGE_NAME     = "ybrainy/${SERVICE_NAME}"
        IMAGE_TAG      = "${params.BUILD_TAG}"
        K8S_NAMESPACE  = 'ybrainy'
        K8S_DEPLOYMENT = 'enrollment-service'
    }

    options { skipDefaultCheckout(true) }

    stages {

        stage('Docker Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                        sh """
                            kubectl --kubeconfig=${KUBECONFIG} -n ${K8S_NAMESPACE} \
                                set image deployment/${K8S_DEPLOYMENT} \
                                ${K8S_DEPLOYMENT}=${IMAGE_NAME}:${IMAGE_TAG}

                            kubectl --kubeconfig=${KUBECONFIG} -n ${K8S_NAMESPACE} \
                                rollout status deployment/${K8S_DEPLOYMENT} --timeout=120s
                        """
                    }
                }
            }
        }
    }

    post {
        success  { echo "CD passed — ${SERVICE_NAME}:${IMAGE_TAG} deployed to Kubernetes" }
        unstable { echo "CD passed Docker build — Kubernetes deploy skipped (cluster not configured yet)" }
        failure  { echo "CD FAILED" }
    }
}
